# Netzwerk / Server
SERVER_IP=192.168.1.115
SERVER_PORT=8181
TRUST_PROXY=true
JSON_LIMIT=2mb

# Modul / Queue / Events
MODULE_TIMEOUT=10000
MAX_COMMANDS=500
MAX_EVENTS=800
COMMAND_MAX_AGE_MS=15000
COMMAND_MAX_ATTEMPTS=40

# Rate-Limits
RL_GLOBAL_WINDOW_MS=10000
RL_GLOBAL_MAX=160
RL_MODULE_WINDOW_MS=5000
RL_MODULE_MAX=80

# Sicherheit / Debug
ENABLE_SECURITY_HEADERS=true
ENABLE_DEBUG_ENDPOINTS=false